# Flash de 16 MB (N16R8), modo QIO
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# PSRAM de 8 MB. A especificação diz OPI; confirmar no boot (log "Found PSRAM").
# Se não iniciar, trocar CONFIG_SPIRAM_MODE_OCT por CONFIG_SPIRAM_MODE_QUAD.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
